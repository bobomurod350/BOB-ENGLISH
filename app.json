{
  "expo": {
    "name": "BOB ENGLISH",
    "slug": "bob-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#170E09",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.bobenglish.app",
      "adaptiveIcon": {
        "backgroundColor": "#170E09"
      }
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ]
    ]
  }
}
