# Backend environment configuration
# Copy this file to .env and add your own private API keys.
# Never commit backend/.env.

PORT=8787
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live


# Optional comma-separated browser origins; native Android requests do not send Origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: configure a public HTTPS URL for the mobile app at build time.
# EXPO_PUBLIC_API_URL=https://your-backend.example.com
